# Keeps src/core pure (CLAUDE.md "Rules for code", WP-04): no curl, borealis, libnx or platform headers, so core stays testable
# on the PC. An allowlist, so a new library can't slip in either. Allowed in src/core/**/*.hpp|cpp:
#   #include <name>            standard C++ headers (no "/" and no ".": <string>, <cstdint>, ...)
#   #include <nlohmann/...>    the vendored JSON library (D26)
#   #include "core/..."        core's own headers
#   #include "Name.inc"        files generated into the build folder (GraphqlDocuments.inc)
# Run as: cmake -DCORE_DIR=<repo>/src/core -P CheckIncludes.cmake (ctest entry unit.core-includes). Fails with the list.
cmake_minimum_required(VERSION 3.16)

file(GLOB_RECURSE files "${CORE_DIR}/*.hpp" "${CORE_DIR}/*.cpp")
set(bad "")
set(count 0)
foreach (file ${files})
    file(STRINGS "${file}" lines REGEX "^[ \t]*#[ \t]*include")
    foreach (line IN LISTS lines)
        math(EXPR count "${count} + 1")
        if (line MATCHES "#[ \t]*include[ \t]*<([^>]*)>")
            set(header "${CMAKE_MATCH_1}")
            if (header MATCHES "^[a-z_0-9]+$" OR header MATCHES "^nlohmann/")
                continue()
            endif ()
        elseif (line MATCHES "#[ \t]*include[ \t]*\"([^\"]*)\"")
            set(header "${CMAKE_MATCH_1}")
            if (header MATCHES "^core/" OR header MATCHES "^[A-Za-z0-9_]+\\.inc$")
                continue()
            endif ()
        endif ()
        file(RELATIVE_PATH rel "${CORE_DIR}" "${file}")
        string(APPEND bad "  src/core/${rel}: ${line}\n")
    endforeach ()
endforeach ()

if (count EQUAL 0)
    message(FATAL_ERROR "no #include lines found under ${CORE_DIR}: wrong folder?")
endif ()
if (bad)
    message(FATAL_ERROR "core may only include the standard library, nlohmann/json and core's own headers. Not allowed:\n${bad}")
endif ()
message(STATUS "core includes OK (${count} include lines checked)")
