<!-- Search all (src/ui/browse/GlobalSearchActivity, WP-14b, D56): a bar ("2 of 4 sources done", Search for a new text) and
     below it a row per source (the grid, added in code: a card + up to 5 covers, 6 columns over the full width).
     Touch targets are at least 72 px high (D16). -->
<brls:AppletFrame
    backgroundColor="@theme/brls/background"
    iconInterpolation="linear"
    footerHidden="false">

    <brls:Box
        id="search/root"
        width="auto"
        height="auto"
        axis="column"
        grow="1.0">

        <brls:Box
            width="auto"
            height="72"
            axis="row"
            alignItems="center"
            paddingLeft="24"
            paddingRight="24"
            marginTop="8">

            <brls:Label
                id="search/progress"
                width="auto"
                grow="1.0"
                shrink="1.0"
                fontSize="18"
                text="" />

            <brls:Button
                id="search/search"
                style="bordered"
                height="72"
                marginLeft="16"
                paddingLeft="12"
                paddingRight="12"
                text="@i18n/browse/search" />

        </brls:Box>

        <brls:Box
            id="search/body"
            width="auto"
            height="auto"
            grow="1.0"
            axis="column" />

    </brls:Box>

</brls:AppletFrame>
