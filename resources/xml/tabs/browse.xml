<!-- The Browse tab (src/ui/browse/BrowseTab, WP-14, D56): a bar (a note, Refresh) and below it the sources, one per row
     (a one-column list, added in code), or a status. Touch targets are 72 px high (D16). -->
<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Box
        id="browse/bar"
        width="auto"
        height="72"
        axis="row"
        alignItems="center"
        paddingLeft="24"
        paddingRight="24">

        <brls:Label
            id="browse/note"
            width="auto"
            grow="1.0"
            shrink="1.0"
            fontSize="18"
            text="@i18n/browse/sources" />

        <brls:Button
            id="browse/refresh"
            style="bordered"
            height="72"
            marginLeft="16"
            paddingLeft="12"
            paddingRight="12"
            text="@i18n/browse/refresh" />

    </brls:Box>

    <brls:Box
        id="browse/body"
        width="auto"
        height="auto"
        grow="1.0"
        axis="column" />

</brls:Box>
