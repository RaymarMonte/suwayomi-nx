<!-- The Settings tab (src/ui/main/SettingsTab, WP-08). Every row is a cell: a tap or A acts on it (D16). -->
<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/settings/server" />

            <brls:DetailCell
                minHeight="72"
                id="settings/address"
                title="@i18n/settings/address" />

            <brls:DetailCell
                minHeight="72"
                id="settings/login"
                title="@i18n/settings/login" />

            <brls:DetailCell
                minHeight="72"
                id="settings/logout"
                title="@i18n/settings/logout" />

            <brls:DetailCell
                minHeight="72"
                id="settings/server_version"
                title="@i18n/settings/server_version" />

            <brls:Header
                width="auto"
                height="auto"
                marginTop="30"
                title="@i18n/settings/about" />

            <brls:DetailCell
                minHeight="72"
                id="settings/version"
                title="@i18n/settings/version" />

            <brls:DetailCell
                minHeight="72"
                id="settings/mode"
                title="@i18n/settings/mode" />

            <brls:DetailCell
                minHeight="72"
                id="settings/memory"
                title="@i18n/settings/memory" />

            <brls:DetailCell
                minHeight="72"
                id="settings/safe_mode"
                title="@i18n/settings/safe_mode" />

            <brls:DetailCell
                minHeight="72"
                id="settings/crash_logs"
                title="@i18n/settings/crash_logs" />

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
