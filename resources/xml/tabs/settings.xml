<!-- The Settings tab (src/ui/main/SettingsTab, WP-08). Every row is a cell: a tap or A acts on it (D16). -->
<brls:Box
    width="auto"
    height="auto">

    <!-- WP-18c: "centered", like the library grid: every D-pad press moves one row and the list scrolls to it. borealis's
         default ("natural") only scrolls while the button is held when the next row isn't fully on screen, so a short
         press could end before the focus moved (the press "lost" under "Delete Switch downloads after reading"). -->
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/settings/server" />

            <brls:DetailCell
                minHeight="72"
                id="settings/address"
                title="@i18n/settings/address" />

            <brls:DetailCell
                minHeight="72"
                id="settings/login"
                title="@i18n/settings/login" />

            <brls:DetailCell
                minHeight="72"
                id="settings/logout"
                title="@i18n/settings/logout" />

            <brls:DetailCell
                minHeight="72"
                id="settings/server_version"
                title="@i18n/settings/server_version" />

            <brls:SelectorCell
                minHeight="72"
                id="settings/source_wait" />

            <brls:Label
                width="auto"
                height="auto"
                marginTop="8"
                marginLeft="16"
                fontSize="16"
                textColor="@theme/brls/text_disabled"
                text="@i18n/settings/source_wait_note" />

            <brls:Header
                width="auto"
                height="auto"
                marginTop="30"
                title="@i18n/settings/browse" />

            <brls:BooleanCell
                minHeight="72"
                id="settings/ask_categories" />

            <brls:Header
                width="auto"
                height="auto"
                marginTop="30"
                title="@i18n/settings/switch_downloads" />

            <brls:SelectorCell
                minHeight="72"
                id="settings/switch_space" />

            <brls:BooleanCell
                minHeight="72"
                id="settings/switch_delete_after_reading" />

            <brls:Label
                width="auto"
                height="auto"
                marginTop="8"
                marginLeft="16"
                fontSize="16"
                textColor="@theme/brls/text_disabled"
                text="@i18n/settings/switch_delete_after_reading_note" />

            <brls:Header
                width="auto"
                height="auto"
                marginTop="30"
                title="@i18n/settings/server_downloads" />

            <brls:BooleanCell
                minHeight="72"
                id="settings/delete_after_reading" />

            <brls:Label
                width="auto"
                height="auto"
                marginTop="8"
                marginLeft="16"
                fontSize="16"
                textColor="@theme/brls/text_disabled"
                text="@i18n/settings/delete_after_reading_note" />

            <brls:Header
                width="auto"
                height="auto"
                marginTop="30"
                title="@i18n/settings/about" />

            <brls:DetailCell
                minHeight="72"
                id="settings/version"
                title="@i18n/settings/version" />

            <brls:DetailCell
                minHeight="72"
                id="settings/mode"
                title="@i18n/settings/mode" />

            <brls:BooleanCell
                minHeight="72"
                id="settings/applet_tip" />

            <brls:DetailCell
                minHeight="72"
                id="settings/memory"
                title="@i18n/settings/memory" />

            <brls:DetailCell
                minHeight="72"
                id="settings/safe_mode"
                title="@i18n/settings/safe_mode" />

            <brls:DetailCell
                minHeight="72"
                id="settings/crash_logs"
                title="@i18n/settings/crash_logs" />

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
